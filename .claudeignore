# ==========================================
# DEPENDÊNCIAS
# ==========================================
# O código-fonte de bibliotecas externas não ajuda na lógica do seu app
node_modules/
vendor/
jspm_packages/

# ==========================================
# ARQUIVOS LOCK
# ==========================================
# São gigantescos, cheios de hashes e versões que a IA não precisa ler
package-lock.json
yarn.lock
pnpm-lock.yaml
composer.lock

# ==========================================
# BUILD, COMPIILADOS E CACHE
# ==========================================
# Código minificado ou gerado por máquina gasta muitos tokens à toa
dist/
build/
out/
.next/
.nuxt/
.cache/
*.min.js
*.min.css
*.map
.turbo/

# ==========================================
# LOGS E DADOS LOCAIS
# ==========================================
# Histórico de execução e bancos locais apenas poluem a leitura
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
*.sqlite
*.sqlite3
*.db

# ==========================================
# SEGREDOS E AMBIENTE (Crucial para Segurança)
# ==========================================
# Nunca envie credenciais para a IA ler
.env
.env.*
*.pem
*.key
*.cert

# ==========================================
# MÍDIA E BINÁRIOS
# ==========================================
# Modelos de linguagem leem texto. Binários viram uma sopa de caracteres caríssima
*.jpg
*.jpeg
*.png
*.gif
*.ico
*.webp
*.svg
*.mp4
*.mp3
*.wav
*.pdf
*.zip
*.tar
*.tar.gz
*.rar

# ==========================================
# ARQUIVOS DE SISTEMA E IDE
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ==========================================
# CONTROLE DE VERSÃO
# ==========================================
.git/