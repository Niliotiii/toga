{
  "expo": {
    "name": "Toga",
    "slug": "toga",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danilosaiter.toga",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "sdkVersion"
      }
    },
    "android": {
      "package": "com.danilosaiter.toga",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFB"
      },
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": {
        "policy": "sdkVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-asset", "expo-font"],
    "extra": {
      "eas": {
        "projectId": "dcf99906-a8b1-463a-9cbd-707e2e7f491c"
      }
    },
    "owner": "saiter-team",
    "updates": {
      "url": "https://u.expo.dev/dcf99906-a8b1-463a-9cbd-707e2e7f491c"
    }
  }
}
